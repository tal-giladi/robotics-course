<?xml version="1.0"?>
<!--
  first_world.sdf — lesson 06.03. A ground plane, a box that falls, a ramp with a box that may
  or may not slide, and a wall. Small enough to read in one sitting.

    gz sim first_world.sdf                 # GUI (paused; press play)
    gz sim -s -r first_world.sdf           # headless server, running
    gz sim -s first_world.sdf              # headless server, paused: step it with gz service

  Numbers to predict (FP.02, FP.03):
    drop_box   starts with its bottom 0.95 m above the ground → lands after sqrt(2*0.95/9.8) = 0.440 s
    slider     on a 20° ramp: slides if mu < tan(20°) = 0.364; with mu = 0.3 it accelerates at
               g (sin 20° − 0.3 cos 20°) = 0.589 m/s² → 0.295 m along the ramp after 1 s
-->
<sdf version="1.9">
  <world name="first_world">

    <!-- 1 ms physics steps, try to run in real time (real_time_factor 0 = as fast as possible) -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Systems (plugins): a world does nothing unless you load them -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <gravity>0 0 -9.8</gravity>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- A 10 cm, 0.5 kg box whose bottom starts 0.95 m above the ground (centre at z = 1.0) -->
    <model name="drop_box">
      <pose>2 0 1.0 0 0 0</pose>
      <!-- Publishes this model's pose on /model/drop_box/pose with frame names, so it bridges to /tf (06.04) -->
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_model_pose>true</publish_model_pose>
        <publish_link_pose>false</publish_link_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <update_frequency>50</update_frequency>
      </plugin>
      <link name="link">
        <inertial>
          <mass>0.5</mass>
          <!-- solid cube: I = m a² / 6 = 0.5 * 0.1² / 6 -->
          <inertia><ixx>8.33e-4</ixx><iyy>8.33e-4</iyy><izz>8.33e-4</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
          <material><ambient>0.9 0.2 0.2 1</ambient><diffuse>0.9 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- A static 3 m ramp pitched 20° (0.349 rad): its +x end is lower -->
    <model name="ramp">
      <static>true</static>
      <pose>0 0 1.2 0 0.349066 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.0 1.0 0.1</size></box></geometry>
          <surface><friction><ode><mu>0.3</mu><mu2>0.3</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.0 1.0 0.1</size></box></geometry>
          <material><ambient>0.3 0.5 0.9 1</ambient><diffuse>0.3 0.5 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- A box resting on the ramp, 1.2 m up-slope from the ramp centre, same pitch -->
    <model name="slider">
      <pose>-1.093429 0 1.704393 0 0.349066 0</pose>
      <!-- Publishes this model's pose on /model/slider/pose with frame names, so it bridges to /tf (06.04) -->
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_model_pose>true</publish_model_pose>
        <publish_link_pose>false</publish_link_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <update_frequency>50</update_frequency>
      </plugin>
      <link name="link">
        <inertial>
          <mass>0.5</mass>
          <inertia><ixx>8.33e-4</ixx><iyy>8.33e-4</iyy><izz>8.33e-4</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
          <surface><friction><ode><mu>0.3</mu><mu2>0.3</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
          <material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- A static wall: collision and visual are separate on purpose (see 06.05) -->
    <model name="wall">
      <static>true</static>
      <pose>0 -2 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.0 0.1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.0 0.1 0.5</size></box></geometry>
          <material><ambient>0.93 0.9 0.82 1</ambient><diffuse>0.93 0.9 0.82 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
