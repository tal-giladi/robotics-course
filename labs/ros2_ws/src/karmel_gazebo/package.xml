<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>karmel_gazebo</name>
  <version>0.1.0</version>
  <description>Gazebo Harmonic worlds and simulation launch for karmel (ros_gz_sim, ros_gz_bridge, gz_ros2_control).</description>
  <maintainer email="course@example.com">Robotics course</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>karmel_description</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- karmel_bringup's controllers.yaml is looked up at launch time only (no build/exec cycle). -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
