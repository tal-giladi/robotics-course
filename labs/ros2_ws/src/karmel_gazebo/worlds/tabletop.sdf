<?xml version="1.0"?>
<!--
  tabletop.sdf — a low table with small coloured objects, for vision and manipulation lessons.

  The table top is 12 cm high so karmel's camera (14.5 cm above the floor) looks slightly down
  onto it from 0.5–1 m away. Spawn the robot at the origin facing +x; the table is 0.8 m ahead.

  Objects are dynamic (they have mass and inertia) so they can be pushed or grasped:
    red_cube      4 cm       green_cylinder  r 2 cm, h 6 cm
    blue_sphere   r 2.5 cm   yellow_box      6 x 4 x 3 cm
-->
<sdf version="1.9">
  <world name="tabletop">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <gravity>0 0 -9.8</gravity>
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.85 0.9 1</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.75 0.72 0.68 1</ambient><diffuse>0.75 0.72 0.68 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- A back wall gives the camera a plain background and the LiDAR something to see. -->
    <model name="back_wall">
      <static>true</static>
      <pose>2.0 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 3 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.1 3 1</size></box></geometry>
          <material><ambient>0.93 0.93 0.9 1</ambient><diffuse>0.93 0.93 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="table">
      <static>true</static>
      <pose>1.1 0 0 0 0 0</pose>
      <link name="link">
        <collision name="top_collision">
          <pose>0 0 0.11 0 0 0</pose>
          <geometry><box><size>0.6 0.9 0.02</size></box></geometry>
        </collision>
        <visual name="top_visual">
          <pose>0 0 0.11 0 0 0</pose>
          <geometry><box><size>0.6 0.9 0.02</size></box></geometry>
          <material><ambient>0.55 0.4 0.25 1</ambient><diffuse>0.55 0.4 0.25 1</diffuse></material>
        </visual>
        <collision name="base_collision">
          <pose>0 0 0.05 0 0 0</pose>
          <geometry><box><size>0.5 0.8 0.10</size></box></geometry>
        </collision>
        <visual name="base_visual">
          <pose>0 0 0.05 0 0 0</pose>
          <geometry><box><size>0.5 0.8 0.10</size></box></geometry>
          <material><ambient>0.3 0.2 0.12 1</ambient><diffuse>0.3 0.2 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Objects rest on the table top (z = 0.12). Inertias: solid box / cylinder / sphere formulas. -->
    <model name="red_cube">
      <pose>0.95 0.2 0.14 0 0 0.3</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>1.33e-5</ixx><iyy>1.33e-5</iyy><izz>1.33e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision"><geometry><box><size>0.04 0.04 0.04</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="green_cylinder">
      <pose>1.0 -0.05 0.15 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>2.0e-5</ixx><iyy>2.0e-5</iyy><izz>1.0e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision"><geometry><cylinder><radius>0.02</radius><length>0.06</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.02</radius><length>0.06</length></cylinder></geometry>
          <material><ambient>0.1 0.75 0.2 1</ambient><diffuse>0.1 0.75 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="blue_sphere">
      <pose>1.2 0.1 0.145 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.03</mass>
          <inertia><ixx>7.5e-6</ixx><iyy>7.5e-6</iyy><izz>7.5e-6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision"><geometry><sphere><radius>0.025</radius></sphere></geometry></collision>
        <visual name="visual">
          <geometry><sphere><radius>0.025</radius></sphere></geometry>
          <material><ambient>0.1 0.25 0.9 1</ambient><diffuse>0.1 0.25 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="yellow_box">
      <pose>1.15 -0.25 0.135 0 0 -0.4</pose>
      <link name="link">
        <inertial>
          <mass>0.04</mass>
          <inertia><ixx>8.3e-6</ixx><iyy>1.5e-5</iyy><izz>1.7e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision"><geometry><box><size>0.06 0.04 0.03</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.06 0.04 0.03</size></box></geometry>
          <material><ambient>0.95 0.85 0.1 1</ambient><diffuse>0.95 0.85 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
